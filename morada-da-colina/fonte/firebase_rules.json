{
  "rules": {
    "players": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['n','x','z'])"
      }
    },
    "chat": {
      ".read": "auth != null",
      "$msg": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.child('u').val() === auth.uid && newData.child('m').isString() && newData.child('m').val().length <= 120"
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || !data.parent().child('players').hasChild(data.child('host').val() + ''))"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['n','x','z'])"
          }
        },
        "caught": {
          ".write": "auth != null && data.parent().child('meta/host').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && data.parent().parent().child('meta/seeker').val() === auth.uid"
          }
        },
        "chat": {
          ".write": "auth != null && data.parent().child('meta/host').val() === auth.uid",
          "$msg": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.child('u').val() === auth.uid && newData.child('m').isString() && newData.child('m').val().length <= 120"
          }
        }
      }
    }
  }
}
